# Server
# development | staging | production
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Keep <PASSWORD> exactly as written in DATABASE. server.js replaces it with DATABASE_PASSWORD.
# In staging and production the server refuses a connection without TLS (use mongodb+srv:// or
# tls=true) and a local database (SEC-003). Development is not restricted.
DATABASE=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?appName=<APP_NAME>
DATABASE_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Internal AI service (docker compose up ai). Mock mode on laptops.
AI_SERVICE_URL=http://127.0.0.1:8000
# The API never waits longer than this for an analysis (20 s at most)
AI_TIMEOUT_MS=20000

# Max register/login requests per IP per 15 minutes. Keep the default in staging and production.
# AUTH_RATE_LIMIT=20

# Max recitation uploads per signed-in account per 15 minutes. Keep the default unless asked.
# UPLOAD_RATE_LIMIT=60

# How many proxies (load balancers) sit in front of the API. 0 on a laptop. Set it to the real
# number in staging and production, or every client shares one rate limit.
# TRUST_PROXY=0
